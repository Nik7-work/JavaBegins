<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="nl.inholland.quiz.controller.ResultsController"
      alignment="CENTER"
      spacing="22"
      styleClass="screen">

    <Label text="QUIZ COMPLETE"
           styleClass="eyebrow"/>

    <Label text="Your Results"
           styleClass="hero"/>

    <Label fx:id="summaryLabel"
           text="Summary"
           styleClass="heading"
           wrapText="true"/>

    <Label fx:id="statusLabel"
           text="Saving results..."
           styleClass="status"
           wrapText="true"/>

    <Button text="Back to menu"
            onAction="#backToMenu"
            styleClass="primary"/>

</VBox>
