<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="nl.inholland.quiz.controller.MenuController"
      alignment="CENTER"
      spacing="18"
      styleClass="root-container">

    <Label text="JAVA FUNDAMENTALS"
           styleClass="subtitle"/>

    <Label text="Quiz Game"
           styleClass="title"/>

    <Label fx:id="titleLabel"
           text="No quiz selected"
           styleClass="description"
           wrapText="true"/>

    <Label fx:id="infoLabel"
           text="Load a JSON quiz to begin."
           styleClass="description"
           wrapText="true"/>

    <HBox alignment="CENTER"
          spacing="15">

        <Button text="Load Quiz"
                onAction="#loadQuiz"
                styleClass="primary-button"/>

        <Button fx:id="startButton"
                text="Start Quiz"
                onAction="#startQuiz"
                disable="true"
                styleClass="secondary-button"/>

    </HBox>

    <Label fx:id="statusLabel"
           text="Select a quiz file."
           styleClass="description"
           wrapText="true"/>

</VBox>
