<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="nl.inholland.quiz.controller.MenuController"
      alignment="CENTER"
      spacing="18"
      styleClass="screen">

    <Label text="JAVA FUNDAMENTALS"
           styleClass="eyebrow"/>

    <Label text="Quiz Game"
           styleClass="hero"/>

    <Label fx:id="titleLabel"
           text="No quiz selected"
           styleClass="heading"
           wrapText="true"
           maxWidth="500"
           alignment="CENTER"/>

    <Label fx:id="infoLabel"
           text="Load a JSON quiz to begin."
           styleClass="status"
           wrapText="true"
           maxWidth="500"
           alignment="CENTER"/>

    <HBox alignment="CENTER"
          spacing="15">

        <Button text="Load Quiz"
                onAction="#loadQuiz"
                styleClass="primary"/>

        <Button fx:id="startButton"
                text="Start Quiz"
                onAction="#startQuiz"
                disable="true"
                styleClass="secondary"/>

    </HBox>

    <Label fx:id="statusLabel"
           text="Select a quiz file."
           styleClass="status"
           wrapText="true"
           maxWidth="500"
           alignment="CENTER"/>

</VBox>
