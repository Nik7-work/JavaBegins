<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="nl.inholland.nl.javabegins.MainController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/>
    </padding>

    <Label fx:id="welcomeLabel" text="Welcome!" style="-fx-font-size: 20px;"/>

    <Button text="Students" onAction="#onStudentsButtonClick" prefWidth="200"/>
    <Button text="Teachers" onAction="#onTeachersButtonClick" prefWidth="200"/>
</VBox>